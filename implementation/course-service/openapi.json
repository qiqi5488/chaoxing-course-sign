  "components": {
    "schemas": {
      "Challenge": {
        "properties": {
          "enc2": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Enc2"
          },
          "validate": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Validate"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "enc2",
          "validate"
        ],
        "title": "Challenge"
      },
      "Face": {
        "properties": {
          "currentFaceId": {
            "type": "string",
            "maxLength": 256,
            "title": "Currentfaceid",
            "default": ""
          },
          "faceEnc": {
            "type": "string",
            "maxLength": 4096,
            "title": "Faceenc",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Face"
      },
      "Grant": {
        "properties": {
          "days": {
            "anyOf": [
              {
                "type": "integer",
                "enum": [
                  1,
                  7,
                  30
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Days"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Grant"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Location": {
        "properties": {
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "address": {
            "type": "string",
            "maxLength": 512,
            "title": "Address",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "title": "Location"
      },
      "Login": {
        "properties": {
          "identifier": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Identifier"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "format": "password",
            "title": "Password",
            "writeOnly": true
          },
          "nickname": {
            "type": "string",
            "maxLength": 20,
            "title": "Nickname",
            "default": ""
          },
          "grantDays": {
            "anyOf": [
              {
                "type": "integer",
                "enum": [
                  1,
                  7,
                  30
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Grantdays"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "identifier",
          "password"
        ],
        "title": "Login"
      },
      "MonitorSettings": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "autoSign": {
            "type": "boolean",
            "title": "Autosign",
            "default": false
          },
          "intervalSeconds": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 10.0,
            "title": "Intervalseconds",
            "default": 10
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "enabled"
        ],
        "title": "MonitorSettings"
      },
      "Photo": {
        "properties": {
          "objectId": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Objectid"
          },
          "photoResult": {
            "type": "string",
            "maxLength": 16000,
            "minLength": 1,
            "title": "Photoresult"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "objectId",
          "photoResult"
        ],
        "title": "Photo"
      },
      "QrBatch": {
        "properties": {
          "accountIds": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Accountids"
          },
          "qrText": {
            "type": "string",
            "maxLength": 8192,
            "minLength": 1,
            "title": "Qrtext"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ]
